# target to build an object file
src/test/scale_server.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/scale_server.dir/build.make CMakeFiles/scale_server.dir/src/test/scale_server.cpp.o
.PHONY : src/test/scale_server.cpp.o

src/test/scale_server.i: src/test/scale_server.cpp.i
.PHONY : src/test/scale_server.i

# target to preprocess a source file
src/test/scale_server.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/scale_server.dir/build.make CMakeFiles/scale_server.dir/src/test/scale_server.cpp.i
.PHONY : src/test/scale_server.cpp.i

src/test/scale_server.s: src/test/scale_server.cpp.s
.PHONY : src/test/scale_server.s

# target to generate assembly for a file
src/test/scale_server.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/scale_server.dir/build.make CMakeFiles/scale_server.dir/src/test/scale_server.cpp.s
.PHONY : src/test/scale_server.cpp.s

