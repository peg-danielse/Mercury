# Sets found to an executable stress-ng, or leaves it empty.
# The binary is this repository's benchmarks/stress-ng/stress-ng. DSB_ROOT overrides that tree.
found=${found:-}
if [ -z "${found}" ]; then
  here=$(CDPATH= cd "$(dirname "$0")" && pwd)
  repo=$(CDPATH= cd "$here/../../.." && pwd)
  if [ -n "${DSB_ROOT:-}" ] && [ -x "$DSB_ROOT/stress-ng/stress-ng" ]; then
    found=$DSB_ROOT/stress-ng/stress-ng
  elif [ -x "$repo/benchmarks/stress-ng/stress-ng" ]; then
    found=$repo/benchmarks/stress-ng/stress-ng
  fi
fi
