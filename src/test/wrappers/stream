#!/bin/sh
set -eu
found=
for dir in "${HOME}/benchmarks/stress-ng" "${HOME}/Benchmarks/stress-ng"; do
  if [ -x "${dir}/stress-ng" ]; then
    found=${dir}/stress-ng
    break
  fi
done
if [ -z "${found}" ]; then
  echo "stress-ng binary not found" >&2
  exit 127
fi
exec "${found}" --stream 1 --stream-l3-size 32M --timeout 0 --quiet
