        <mxCell id="heads" value="&lt;b&gt;ActionHeads&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="20" width="240" height="480" as="geometry" />
        </mxCell>
        <mxCell id="htool" value="&lt;b&gt;tool&lt;/b&gt; &amp;rarr; 10 tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="45" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hauto" value="&lt;b&gt;auto&lt;/b&gt; domain score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hroute" value="&lt;b&gt;route&lt;/b&gt; &amp;rarr; shed / restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="135" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hsvc" value="&lt;b&gt;service&lt;/b&gt; &amp;rarr; pointer over N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
