<mxfile host="app.diagrams.net">
  <diagram id="gate" name="Trouble gate">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;llmctl.py --llm rl --gate&lt;/b&gt;: when the action model is called" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="state" value="Mercury &lt;b&gt;/llm/state&lt;/b&gt;&lt;br&gt;averaged over --window-ms 1000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;Check&lt;/b&gt; every --every 0.5 s&lt;br&gt;log check + outcome (reward input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="any" value="Any trouble?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="held" value="Same trouble the model&lt;br&gt;held on &amp;lt; 60 s ago?&lt;br&gt;(--rehold)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="streak" value="streak += 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="90" y="540" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="confirm" value="streak &amp;ge; 2 (--confirm)&lt;br&gt;and cooldown over?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="620" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="episode" value="&lt;b&gt;Episode&lt;/b&gt;&lt;br&gt;action_turns()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="90" y="770" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cool" value="&lt;b&gt;Cooldown 2 s&lt;/b&gt; (--cooldown)&lt;br&gt;only holds &amp;rarr; rehold 60 s on that trouble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="1010" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="list" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;trouble()&lt;/b&gt; flags:&lt;br&gt;&amp;bull; &lt;b&gt;Hot L3 domain&lt;/b&gt;: load &amp;gt; 80% and shared, or holding a short service, or &amp;ge; 25% outside load&lt;br&gt;&amp;bull; &lt;b&gt;Service short of CPUs&lt;/b&gt;: occupancy &amp;ge; 0.9 and pressure &amp;ge; 0.10&lt;br&gt;&amp;bull; &lt;b&gt;Pool saturated&lt;/b&gt;: busy &amp;gt; 80%, or pressure &amp;ge; 0.25 with allocated &amp;gt; cores&lt;br&gt;&amp;bull; &lt;b&gt;Outside load&lt;/b&gt; in a pool domain &amp;ge; 25%&lt;br&gt;&amp;bull; &lt;b&gt;Latency&lt;/b&gt;: p95 &amp;gt; 2&amp;times; the healthy reference&lt;br&gt;&amp;bull; &lt;b&gt;Pool underused&lt;/b&gt;: above start, &amp;le; 35% busy, nothing else wrong (shrink)&lt;br&gt;&amp;bull; &lt;b&gt;Shed routes&lt;/b&gt; while critical latency is fine (restore)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="150" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="choose" value="&lt;b&gt;choose&lt;/b&gt;(model, state, used)&lt;br&gt;legality mask applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="360" y="770" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="exec" value="&lt;b&gt;execute&lt;/b&gt; &amp;rarr; POST /llm/act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="360" y="870" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="hold, refused,&lt;br&gt;or 6 calls?&lt;br&gt;(--max-actions)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="375" y="960" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fresh" value="read a fresh /llm/state&lt;br&gt;mark that service and pool tool used&lt;br&gt;(not offered again this episode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="650" y="860" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="state" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="check" target="any">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="evaluates" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="check" target="list">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="any" target="held">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="held" target="streak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="streak" target="confirm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="confirm" target="episode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="no: streak = 0" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#999999;" edge="1" parent="1" source="any" target="check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="285" />
              <mxPoint x="30" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" value="yes: ignored" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#999999;" edge="1" parent="1" source="held" target="check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="435" />
              <mxPoint x="20" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="no: wait" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#999999;" edge="1" parent="1" source="confirm" target="check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10" y="670" />
              <mxPoint x="10" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="episode" target="choose">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="choose" target="exec">
