          <mxGeometry x="1110" y="360" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B10" value="&lt;b&gt;winner.pt&lt;/b&gt;, stop&lt;br&gt;(or after 8 rounds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1110" y="500" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="B6" value="&lt;b&gt;reward_series&lt;/b&gt;&lt;br&gt;step_reward at each check:&lt;br&gt;goodput &amp;minus; latency &amp;minus; errors&lt;br&gt;+ utilization &amp;minus; resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="600" y="500" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="B7" value="&lt;b&gt;decision_rows&lt;/b&gt;&lt;br&gt;advantage = reward 1&amp;ndash;6 s after &amp;minus; 5 s before,&lt;br&gt;minus the same load phase's mean&lt;br&gt;z &amp;gt; 0.25: clone (weight z, at most 3)&lt;br&gt;z &amp;lt; &amp;minus;0.25: avoid; refused: avoid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="B8" value="&lt;b&gt;mix_probs&lt;/b&gt;&lt;br&gt;50% of draws: teacher r1 rows&lt;br&gt;50%: student rows of the last 3 rounds,&lt;br&gt;even across tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="625" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="B9" value="&lt;b&gt;fit_action&lt;/b&gt;, 200 steps&lt;br&gt;from the best round's weights&lt;br&gt;clone: &amp;minus;w log p(call)&lt;br&gt;avoid: &amp;minus;w log(1 &amp;minus; p(call))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="625" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="C1" value="&lt;b&gt;Settings&lt;/b&gt; gnn-rl, tf-rl,&lt;br&gt;gnn-imitation-rl, tf-imitation-rl&lt;br&gt;scale actors: one continuous value&lt;br&gt;per process (CPUs / 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
