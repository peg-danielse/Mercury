        <mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="stop" target="fresh">
          <mxGeometry relative="1" as="geometry" />
