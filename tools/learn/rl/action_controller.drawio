  <diagram id="learning" name="Teacher, student and RL">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="laneA" value="&lt;b&gt;1. Teacher &amp;rarr; student: offline imitation&lt;/b&gt; (train.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="1280" height="270" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="&lt;b&gt;2. RL fine-tuning on Mercury: advantage-weighted cloning&lt;/b&gt; (cycle.py, action_cycle.sh)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="1280" height="420" as="geometry" />
        </mxCell>
        <mxCell id="laneC" value="&lt;b&gt;3. Scale-actor RL (TD3): separate path, simulated plant only, not in the live cycle&lt;/b&gt; (student.py, td3.py, curve.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="760" width="1280" height="290" as="geometry" />
        </mxCell>
        <mxCell id="A1" value="&lt;b&gt;Luna teacher&lt;/b&gt;&lt;br&gt;LLM via llmctl, trouble-gated&lt;br&gt;48 runs: hotel, social, media&lt;br&gt;repeats r1 and r2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="&lt;b&gt;llmctl.jsonl&lt;/b&gt;&lt;br&gt;state at each episode&lt;br&gt;+ tool calls (accepted / refused)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="&lt;b&gt;episodes_from &amp;rarr; examples_from&lt;/b&gt;&lt;br&gt;each accepted call = (state at turn start, call)&lt;br&gt;refused skipped; no call = hold&lt;br&gt;r1: 4,055 labels (70% scale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="&lt;b&gt;fit_action&lt;/b&gt; (cross-entropy)&lt;br&gt;tool + the arguments it uses&lt;br&gt;legality mask, tool-balanced sampling&lt;br&gt;2,500 steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A5" value="&lt;b&gt;tf-action.pt&lt;/b&gt;&lt;br&gt;luna-action-context-20261108" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1090" y="80" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A6" value="&lt;b&gt;Held-out r2&lt;/b&gt;: 82.3% tool,&lt;br&gt;4.1% full call, 0 would-refuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
