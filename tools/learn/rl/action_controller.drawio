          <mxGeometry x="860" y="240" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="hdom" value="&lt;b&gt;domain&lt;/b&gt; &amp;rarr; pointer over D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="400" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hdomto" value="&lt;b&gt;domain_to&lt;/b&gt; &amp;rarr; target domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="445" width="200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="mask" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Legality mask&lt;/b&gt; (Scene)&lt;br&gt;legal_tools, legal_cpus, growable /&lt;br&gt;shrinkable domains, from pool cores,&lt;br&gt;start, max and each service's CPUs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="540" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="decode" value="&lt;b&gt;decode_choice&lt;/b&gt;&lt;br&gt;one call (hold if nothing legal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="230" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="post" value="&lt;b&gt;execute&lt;/b&gt; &amp;rarr; POST /llm/act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1140" y="340" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note" value="The tool, auto and route heads read the summary, so the tool choice sees latency, the pool size and budget, and the domains. A checkpoint without context (before 2026-11-08 evening) reads only the mean process row." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="370" y="540" width="420" height="90" as="geometry" />
