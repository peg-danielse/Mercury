  <diagram id="model" name="Action model">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;ActionModel&lt;/b&gt; (actions.py): one decision from one Scene" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Process rows&lt;/b&gt; N &amp;times; 10 (local_features)&lt;br&gt;cpu_use, occupancy, pressure,&lt;br&gt;CPUs/16, in_pool, replica, throttled,&lt;br&gt;cpu_wait, IPC/3, log LLC traffic&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="hist" value="&lt;b&gt;History&lt;/b&gt; N &amp;times; 10&lt;br&gt;same rows at the previous decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="topo" value="&lt;b&gt;Topology&lt;/b&gt; N &amp;times; N&lt;br&gt;linked when cpusets share an L3 domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dom" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Domain rows&lt;/b&gt; D &amp;times; 9 (domain_features)&lt;br&gt;in_pool, load, free share, services/8,&lt;br&gt;outside load, IPC/3, LLC traffic,&lt;br&gt;cpu_wait, free to grow into&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="glob" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Context&lt;/b&gt; (global_features)&lt;br&gt;pool cores, max, busy, pressure, allocated,&lt;br&gt;log p95, error rate, log req/s&lt;br&gt;+ pool start, budget left, log(p95 / healthy p95)&lt;br&gt;(context_features, 11)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="enc" value="&lt;b&gt;Process encoder&lt;/b&gt;&lt;br&gt;MLP | GNN | Transformer&lt;br&gt;hidden 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="denc" value="&lt;b&gt;domain_enc&lt;/b&gt; MLP&lt;br&gt;9 &amp;rarr; 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="370" y="405" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pe" value="Process embeddings&lt;br&gt;N &amp;times; 32" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pool" value="&lt;b&gt;Summary&lt;/b&gt; 32: mean process +&lt;br&gt;mean domain + context_enc" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="50" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="de" value="Domain embeddings&lt;br&gt;D &amp;times; 32" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="405" width="170" height="60" as="geometry" />
