          <mxGeometry x="600" y="370" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="&lt;b&gt;score_run&lt;/b&gt;&lt;br&gt;critical-route error %, p95,&lt;br&gt;split by load level&lt;br&gt;best so far &amp;rarr; best.pt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="370" width="200" height="90" as="geometry" />
        </mxCell>
